DATABASE_URL="<set>"
BETTER_AUTH_SECRET="<set>"
BETTER_AUTH_URL="<set>"
# 32-byte hex key for encrypting channel credentials at rest. Back it up: losing it loses every stored token.
ENCRYPTION_KEY="<set>"

# Claude (Console API key). ANTHROPIC_BASE_URL optional (e.g. a gateway holding a Console key).
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="<set>"

# OpenWA gateway (self-hosted, unofficial WhatsApp)
OPENWA_URL="<set>"
OPENWA_API_KEY=""
OPENWA_WEBHOOK_SECRET="<set>"

# Meta app (Instagram + official WhatsApp Cloud API)
META_APP_SECRET=""
META_VERIFY_TOKEN="<set>"
META_API_VERSION="<set>"
# Optional: URL the OpenWA container calls for webhooks (default http://host.docker.internal:<app port>/api/webhooks/openwa)
OPENWA_WEBHOOK_URL=""
