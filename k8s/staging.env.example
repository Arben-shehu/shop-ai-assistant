# Shop AI assistant — STAGING secret template (staging k3s, namespace shop-ai-staging, https://ai.square.al)
#   cp k8s/staging.env.example k8s/.env.staging     # k8s/.env.staging is gitignored, never commit it
# k8s/deploy-staging.sh turns it into the Secret `shop-ai-env` (envFrom of the app, POSTGRES_* of postgres).
#
# FORMAT: plain KEY=value, NO quotes. `kubectl create secret --from-env-file` keeps quotes literally.
# Staging never gets prod secrets or real partner keys: own DB password, own auth secret, own ENCRYPTION_KEY.

# ─── Postgres (in-cluster StatefulSet `postgres`) ─────────────────────────────
POSTGRES_USER=shopai
# URL-safe characters only (it is repeated in DATABASE_URL): e.g. `openssl rand -hex 24`
POSTGRES_PASSWORD=
POSTGRES_DB=shop_ai
# postgresql://shopai:<POSTGRES_PASSWORD>@postgres:5432/shop_ai
DATABASE_URL=

# ─── Better Auth ──────────────────────────────────────────────────────────────
# `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Public https URL; also the base of the widget snippet and the trusted origin.
BETTER_AUTH_URL=https://ai.square.al

# ─── Channel credential encryption ────────────────────────────────────────────
# 32-byte hex: `openssl rand -hex 32`. Back it up: losing it loses every stored channel token.
ENCRYPTION_KEY=

# ─── Claude ───────────────────────────────────────────────────────────────────
# Console API key. Empty = AI replies fail, the rest of the app works.
ANTHROPIC_API_KEY=
# Empty = code default.
ANTHROPIC_MODEL=
# Optional gateway. Leave the line commented out rather than empty.
# ANTHROPIC_BASE_URL=

# ─── OpenWA (unofficial WhatsApp gateway) ─────────────────────────────────────
# NOT deployed on staging (see the note at the top of k8s/staging.yaml). Keep the URL and API key empty.
OPENWA_URL=
OPENWA_API_KEY=
# Still set it (`openssl rand -hex 32`): the webhook route rejects every request when it is empty.
OPENWA_WEBHOOK_SECRET=
# Only once OpenWA runs in-cluster: http://app/api/webhooks/openwa
OPENWA_WEBHOOK_URL=

# ─── Meta (Instagram + WhatsApp Cloud API) ────────────────────────────────────
# Empty on staging unless a Meta test app is wired to https://ai.square.al/api/webhooks/meta
META_APP_SECRET=
# Any random string; it is shown on the Channels page to paste into the Meta app.
META_VERIFY_TOKEN=
# Empty = code default.
META_API_VERSION=
