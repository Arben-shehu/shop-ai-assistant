# Shop AI assistant — STAGING secret template (staging k3s, namespace shop-ai-staging, https://ai.square.al)
#   cp k8s/staging.env.example k8s/.env.staging     # k8s/.env.staging is gitignored, never commit it
# k8s/deploy-staging.sh turns it into the Secret `shop-ai-env` (envFrom of the app, POSTGRES_* of postgres).
#
# FORMAT: plain KEY=value, NO quotes. `kubectl create secret --from-env-file` keeps quotes literally.
# Staging never gets prod secrets or real partner keys: own DB password, own auth secret, own ENCRYPTION_KEY.

# ─── Postgres (in-cluster StatefulSet `postgres`) ─────────────────────────────
POSTGRES_USER=shopai
# URL-safe characters only (it is repeated in DATABASE_URL): e.g. `openssl rand -hex 24`
POSTGRES_PASSWORD=
POSTGRES_DB=shop_ai
# postgresql://shopai:<POSTGRES_PASSWORD>@postgres:5432/shop_ai
DATABASE_URL=

# ─── Better Auth ──────────────────────────────────────────────────────────────
# `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Public https URL; also the base of the widget snippet and the trusted origin.
BETTER_AUTH_URL=https://ai.square.al

# ─── Channel credential encryption ────────────────────────────────────────────
# 32-byte hex: `openssl rand -hex 32`. Back it up: losing it loses every stored channel token.
ENCRYPTION_KEY=

# ─── Claude (through the bclaude gateway) ─────────────────────────────────────
# A bclaude project key (starts with bcs_), not a Console key. Empty = AI replies fail, the rest of the app works.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://bclaude.square.al
ANTHROPIC_MODEL=claude-opus-5-5

# ─── OpenWA (unofficial WhatsApp gateway, StatefulSet `openwa` in this namespace) ─
# In-cluster service: keep as is.
OPENWA_URL=http://openwa:2785
# Generated by the gateway on its first boot (no way to preset it). Leave EMPTY for the first deploy, then:
#   ssh <vps> sudo -n kubectl -n shop-ai-staging exec openwa-0 -- cat /app/data/.api-key
# paste it here and re-run `k8s/deploy-staging.sh --skip-openwa`. Empty = OpenWA channels cannot be created.
OPENWA_API_KEY=
# `openssl rand -hex 32`. Signs the gateway's webhooks; the webhook route rejects every request when it is empty.
OPENWA_WEBHOOK_SECRET=
# Where the gateway POSTs inbound messages: the app Service by FULL name. The gateway's @IsUrl() rejects a bare
# single-label host like http://app/... (the deploy script refuses it too).
OPENWA_WEBHOOK_URL=http://app.shop-ai-staging.svc.cluster.local/api/webhooks/openwa

# ─── Meta (Instagram + WhatsApp Cloud API) ────────────────────────────────────
# Empty on staging unless a Meta test app is wired to https://ai.square.al/api/webhooks/meta
META_APP_SECRET=
# Any random string; it is shown on the Channels page to paste into the Meta app.
META_VERIFY_TOKEN=
# Empty = code default.
META_API_VERSION=
